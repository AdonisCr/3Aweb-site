# WordPress GraphQL endpoint
# Copy this file to .env and set the correct URL for your environment.
# '/graphql' = même origine : en production Vercel réécrit /graphql vers
# admin.allianceactionsafrique.com (voir vercel.json). En local, vite.config.ts
# fait le proxy dans le même sens.
VITE_WPGRAPHQL_ENDPOINT=/graphql
